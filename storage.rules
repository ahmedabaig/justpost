rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{uid}/{assetId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Only the original may come from the app; derived copies are written
      // by the ingest_asset function.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && fileName.matches('original\\.(jpg|jpeg|png|webp|heic|heif)')
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Generated variations are written only by generate_variation, and slides
    // only by render_slide. Files can be fetched but not listed, so the app
    // can open only the paths the server handed out: passed images, plus the
    // others when the server's inspection switch is on.
    match /uploads/{uid}/{assetId}/variations/{fileName} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }

    match /uploads/{uid}/{assetId}/slides/{fileName} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
