rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The app reads everything through Cloud Functions, which filter out raw
    // model output and images that didn't pass their checks. Assets and their
    // run records are written and read only by the server.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
